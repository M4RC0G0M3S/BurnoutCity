-using Microsoft.Xna.Framework; using Microsoft.Xna.Framework.Graphics; namespace BurnoutCity.States { // Placeholder — menu principal não implementado. // O jogo começa diretamente no ExplorationState (ver Game1.Initialize). public class MenuState : BaseState { public override void LoadContent() { } public override void Update(GameTime gameTime) { } public override void Draw(SpriteBatch spriteBatch) { } } }
+using BurnoutCity.Core; using Microsoft.Xna.Framework; using Microsoft.Xna.Framework.Graphics; using Microsoft.Xna.Framework.Input; namespace BurnoutCity.States { public class MenuState : BaseState { private SpriteFont _fontBig = null!; private SpriteFont _fontMedium = null!; private SpriteFont _fontSmall = null!; private KeyboardState _previousKeyboard; private int _selectedIndex = 0; private bool _hasSave; private readonly string[] _options = { "Continuar", "Novo Jogo", "Sair" }; public override void LoadContent() { _fontBig = ContentManager.Load<SpriteFont>("Fonts/FontBig"); _fontMedium = ContentManager.Load<SpriteFont>("Fonts/FontMedium"); _fontSmall = ContentManager.Load<SpriteFont>("Fonts/FontSmall"); _hasSave = SaveManager.Instance.HasSave(); if (!_hasSave) _selectedIndex = 1; } public override void Update(GameTime gameTime) { _hasSave = SaveManager.Instance.HasSave(); KeyboardState keyboard = Keyboard.GetState(); if (WasPressed(keyboard, Keys.Down) || WasPressed(keyboard, Keys.S)) MoveSelection(1); if (WasPressed(keyboard, Keys.Up) || WasPressed(keyboard, Keys.W)) MoveSelection(-1); if (WasPressed(keyboard, Keys.Enter) || WasPressed(keyboard, Keys.Space)) ActivateSelectedOption(); if (WasPressed(keyboard, Keys.Escape)) BurnoutCity.Game1.QuitGame?.Invoke(); _previousKeyboard = keyboard; } public override void Draw(SpriteBatch spriteBatch) { Texture2D pixel = BurnoutCity.Game1.PixelTexture; spriteBatch.Draw(pixel, new Rectangle(0, 0, BurnoutCity.Game1.ScreenWidth, BurnoutCity.Game1.ScreenHeight), new Color(12, 12, 18)); DrawCentered(spriteBatch, _fontBig, "BURNOUT CITY", 130, Color.OrangeRed); DrawCentered(spriteBatch, _fontSmall, "↑/↓ ou W/S para escolher  •  Enter para confirmar", 190, Color.LightGray); int startY = 290; for (int i = 0; i < _options.Length; i++) { bool disabled = i == 0 && !_hasSave; bool selected = i == _selectedIndex; Color color = disabled ? Color.DarkGray : selected ? Color.Yellow : Color.White; string text = _options[i]; if (disabled) text += " (sem save)"; Vector2 size = _fontMedium.MeasureString(text); Vector2 position = new Vector2((BurnoutCity.Game1.ScreenWidth - size.X) / 2f, startY + i * 60); if (selected && !disabled) { Rectangle box = new Rectangle((int)position.X - 30, (int)position.Y - 10, (int)size.X + 60, (int)size.Y + 20); spriteBatch.Draw(pixel, box, Color.White * 0.12f); } spriteBatch.DrawString(_fontMedium, text, position, color); } DrawCentered(spriteBatch, _fontSmall, "Novo Jogo cria um save limpo. Continuar carrega o save existente.", 610, Color.Gray); } private bool WasPressed(KeyboardState keyboard, Keys key) { return keyboard.IsKeyDown(key) && _previousKeyboard.IsKeyUp(key); } private void MoveSelection(int direction) { do { _selectedIndex += direction; if (_selectedIndex < 0) _selectedIndex = _options.Length - 1; if (_selectedIndex >= _options.Length) _selectedIndex = 0; } while (_selectedIndex == 0 && !_hasSave); } private void ActivateSelectedOption() { if (_selectedIndex == 0 && _hasSave) { SaveManager.Instance.Load(); GameStateManager.Instance.PlayerData.LoadFrom(SaveManager.Instance.CurrentSave); GameStateManager.Instance.ChangeState(new ExplorationState()); } else if (_selectedIndex == 1) { SaveManager.Instance.NewGame(); GameStateManager.Instance.PlayerData.LoadFrom(SaveManager.Instance.CurrentSave); GameStateManager.Instance.ChangeState(new ExplorationState()); } else if (_selectedIndex == 2) { BurnoutCity.Game1.QuitGame?.Invoke(); } } private void DrawCentered(SpriteBatch spriteBatch, SpriteFont font, string text, float y, Color color) { Vector2 size = font.MeasureString(text); spriteBatch.DrawString(font, text, new Vector2((BurnoutCity.Game1.ScreenWidth - size.X) / 2f, y), color); } } }
